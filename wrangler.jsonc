{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "salesman-services-v5",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "kv_namespaces": [
    {
      "binding": "SALESMAN_DATA",
      "id": "8d033070ba124741a9cb3481aaede7ab"
    }
  ],
  "triggers": {
    "crons": [
      "17 */6 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
